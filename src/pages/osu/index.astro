---
import Category from "@/layouts/Category.astro";
---

<Category
  title="osu!mania"
  description="The rhythm game I spend way too much time on."
  current="osu"
>
  <!-- Story -->
  <div class="mb-10 bg-bg-elevated border border-border rounded-xl px-6 py-5 max-w-lg mx-auto relative -rotate-[0.5deg]">
    <span class="tape tape-orange absolute -top-2.5 right-6 rotate-[-4deg]"></span>
    <p class="text-sm text-text-muted leading-relaxed text-center">
      words alone can't describe how much i love vsrg games.
    </p>
  </div>

  <!-- Link to osu portfolio -->
  <a
    href="https://kaanreal.github.io/Portfolio/"
    target="_blank"
    rel="noopener noreferrer"
    class="group relative block bg-bg-card border border-dashed border-border rounded-2xl p-8 text-center card-hover max-w-md mx-auto rotate-[0.5deg]"
  >
    <span class="tape tape-pink absolute -top-2.5 left-1/2 -translate-x-1/2 rotate-[-5deg]"></span>
    <p class="text-4xl mb-3 animate-float-swing inline-block">🎹</p>
    <p class="font-heading font-bold text-2xl text-text group-hover:text-brand transition-colors duration-300 mb-1">
      osu! portfolio
    </p>
    <p class="hand-note text-lg text-text-muted/70">
      click me ↗
    </p>
  </a>
</Category>