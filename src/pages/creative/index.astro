---
import Category from "@/layouts/Category.astro";
import { site } from "@/data/site";

const works = [
  {
    title: "Hycean",
    date: "22/05/2026",
    url: "https://osu.ppy.sh/users/36805517",
    image: "https://i.ibb.co/TMFcfj8d/final.png",
  },
  {
    title: "Kaan",
    date: "01/03/2026",
    url: "https://osu.ppy.sh/users/26595459",
    image: "https://i.ibb.co/hJtWhvdn/Banner.png",
  },
];
---

<Category
  title="creative"
  description="Banners, designs, and visual stuff I make for people."
  current="creative"
>
  <!-- Story -->
  <div class="mb-10 bg-bg-elevated border border-border rounded-xl px-6 py-5 max-w-lg mx-auto relative -rotate-[0.5deg]">
    <span class="tape tape-pink absolute -top-2.5 right-6 rotate-[-4deg]"></span>
    <p class="text-sm text-text-muted leading-relaxed text-center">
      i made some <span class="text-text font-medium">banners</span> for people, mostly for osu! profiles. i like keeping it clean and matching the person's vibe.
    </p>
  </div>

  <!-- Works -->
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-5">
      <p class="text-[11px] font-mono text-text-muted/50 tracking-widest uppercase">works</p>
      <span class="h-px flex-1 bg-border"></span>
      <span class="hand-note text-text-muted/50">my little gallery</span>
    </div>
    <div class="grid sm:grid-cols-2 gap-8 gap-y-10">
      {works.map((work, i) => (
        <a
          href={work.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "group relative block bg-bg-card border border-border rounded-xl overflow-hidden card-hover shadow-[0_8px_24px_rgba(0,0,0,0.06)]",
            i % 2 === 0 ? "-rotate-1" : "rotate-1 sm:translate-y-6",
          ]}
        >
          <div class="tape absolute -top-2.5 left-1/2 -translate-x-1/2 rotate-[-3deg] z-10"></div>
          <img
            src={work.image}
            alt={`Banner for ${work.title}`}
            class="w-full h-auto"
            loading="lazy"
          />
          <div class="px-5 py-4 flex items-end justify-between gap-3">
            <div class="text-left">
              <span class="block font-heading text-lg font-bold text-text group-hover:text-brand transition-colors duration-300">
                {work.title}
              </span>
              <span class="hand-note text-text-muted/70">{work.date}</span>
            </div>
            <span class="text-text-muted/30 group-hover:text-brand group-hover:translate-x-1 transition-all duration-300 text-sm flex-shrink-0">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <a
    href={`https://discord.com/users/${site.discordId}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative block bg-bg-elevated border border-dashed border-border rounded-xl p-7 text-center card-hover max-w-md mx-auto"
  >
    <span class="tape tape-yellow absolute -top-2.5 left-1/2 -translate-x-1/2 rotate-[-5deg]"></span>
    <p class="text-2xl mb-2 animate-float-swing inline-block">💬</p>
    <p class="font-heading font-bold text-xl text-text group-hover:text-brand transition-colors duration-300 mb-1">
      want a banner?
    </p>
    <p class="hand-note text-lg text-text-muted/70">
      dm me on discord ↗
    </p>
  </a>
</Category>