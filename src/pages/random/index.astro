---
import Category from "@/layouts/Category.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const handhelds = [
  {
    name: "Nintendo Switch Lite",
    image: `${base}/images/handhelds/switchlitemod.jpg`,
    placeholder: "🎮",
    story: "i got this for really cheap, restored and modded it to my liking.",
  },
  {
    name: "Nintendo Switch OLED",
    image: `${base}/images/handhelds/switcholed.jpg`,
    placeholder: "🕹️",
    story: "the one that started it all. Bricked it many times...",
  },
  {
    name: "Nintendo Switch Lite Mainboard",
    image: `${base}/images/handhelds/switchlitemb.jpg`,
    placeholder: "✨",
    story: "has a long story behind it, but works and is technically a working console.",
  },
];

const keyboards = [
  {
    name: "Mad 60HE",
    image: `${base}/images/keyboards/mad60he.jpg`,
    placeholder: "⌨️",
    story: "it is a cheap keyboard but it also my first serious keyboard that survived my vsrg journey.",
  },
  {
    name: "Wooting 60HE",
    image: `${base}/images/keyboards/wooting60he.jpg`,
    placeholder: "🔧",
    story: "coming soon...",
  },
];
---

<Category
  title="random stuff"
  description="things i'm into. collections, obsessions, and the little rabbit holes i fall into."
  current="random"
>
  <!-- Handhelds Section -->
  <section class="mb-24">
    <div class="mb-10">
      <div class="flex items-center gap-4 mb-2 scroll-reveal">
        <span class="text-3xl animate-float-swing inline-block">🎮</span>
        <div>
          <p class="text-[11px] font-mono text-text-muted/50 tracking-widest uppercase">collection</p>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-text">Handhelds</h2>
        </div>
      </div>
      <p class="hand-note text-lg text-text-muted max-w-lg scroll-reveal" style="animation-delay: 0.1s">little portable gaming devices i've collected. each one has its own vibe.</p>
    </div>

    <div class="space-y-8">
      {handhelds.map((item, i) => (
        <div class:list={["scroll-reveal", i % 2 === 1 ? "reveal-right" : "reveal-left"]} style={`animation-delay: ${0.05 * i}s`}>
          <div class="card-hover flex flex-col sm:flex-row bg-bg-card border border-border rounded-xl overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.06)]"
               class:list={[i % 2 === 1 ? "sm:rotate-1" : "sm:-rotate-1"]}>
            <!-- Photo, polaroid style -->
            <div class="relative sm:w-72 sm:min-w-72 bg-bg-elevated flex items-center justify-center overflow-hidden p-3">
              <div class="tape tape-yellow absolute -top-2 left-8 rotate-[-6deg] z-10"></div>
              <div class="relative w-full aspect-square bg-bg-card border border-border rounded-lg flex items-center justify-center overflow-hidden">
                <img
                  src={item.image}
                  alt={item.name}
                  class="absolute inset-0 w-full h-full object-cover hidden"
                  onload="this.classList.remove('hidden'); this.parentElement.querySelector('.placeholder').classList.add('hidden')"
                />
                <div class="placeholder flex flex-col items-center justify-center gap-2">
                  <span class="text-5xl">{item.placeholder}</span>
                  <span class="hand-note text-text-muted/40">{'add photo'}</span>
                </div>
              </div>
            </div>

            <!-- Story, written to the side -->
            <div class="flex-1 p-6 sm:p-8 flex flex-col justify-center gap-1">
              <p class="hand-note text-text-muted/50">my #{i + 1}</p>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-text group-hover:text-brand transition-colors duration-300 mb-2">
                {item.name}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed">
                {item.story}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Keyboards Section -->
  <section class="mb-24">
    <div class="mb-10">
      <div class="flex items-center gap-4 mb-2 scroll-reveal">
        <span class="text-3xl animate-float-swing inline-block" style="animation-delay: 0.5s">⌨️</span>
        <div>
          <p class="text-[11px] font-mono text-text-muted/50 tracking-widest uppercase">collection</p>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-text">Keyboards</h2>
        </div>
      </div>
      <p class="hand-note text-lg text-text-muted max-w-lg scroll-reveal" style="animation-delay: 0.1s">mechanical keyboards and the rabbit hole of custom builds.</p>
    </div>

    <div class="space-y-8">
      {keyboards.map((item, i) => (
        <div class:list={["scroll-reveal", i % 2 === 1 ? "reveal-right" : "reveal-left"]} style={`animation-delay: ${0.05 * i}s`}>
          <div class="card-hover flex flex-col sm:flex-row bg-bg-card border border-border rounded-xl overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.06)]"
               class:list={[i % 2 === 1 ? "sm:rotate-1" : "sm:-rotate-1"]}>
            <div class="relative sm:w-72 sm:min-w-72 bg-bg-elevated flex items-center justify-center overflow-hidden p-3">
              <div class="tape tape-purple absolute -top-2 left-8 rotate-[-6deg] z-10"></div>
              <div class="relative w-full aspect-square bg-bg-card border border-border rounded-lg flex items-center justify-center overflow-hidden">
                <img
                  src={item.image}
                  alt={item.name}
                  class="absolute inset-0 w-full h-full object-cover hidden"
                  onload="this.classList.remove('hidden'); this.parentElement.querySelector('.placeholder').classList.add('hidden')"
                />
                <div class="placeholder flex flex-col items-center justify-center gap-2">
                  <span class="text-5xl">{item.placeholder}</span>
                  <span class="hand-note text-text-muted/40">{'add photo'}</span>
                </div>
              </div>
            </div>

            <div class="flex-1 p-6 sm:p-8 flex flex-col justify-center gap-1">
              <p class="hand-note text-text-muted/50">my #{i + 1}</p>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-text group-hover:text-brand transition-colors duration-300 mb-2">
                {item.name}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed">
                {item.story}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- More to come -->
  <div class="mb-16">
    <div class="relative bg-bg-elevated border border-dashed border-border rounded-2xl p-8 text-center scroll-reveal max-w-lg mx-auto rotate-[0.5deg]">
      <span class="tape tape-pink absolute -top-2.5 left-1/2 -translate-x-1/2 rotate-[-4deg]"></span>
      <p class="animate-float-swing inline-block mb-2">🌱</p>
      <p class="font-heading font-bold text-xl text-text mb-1">
        more collections coming soon
      </p>
      <p class="hand-note text-lg text-text-muted/70">
        probably more stuff i get obsessed with
      </p>
    </div>
  </div>
</Category>

<style>
  .scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-left {
    transform: translateX(-24px) translateY(12px);
  }
  .reveal-left.is-visible {
    transform: translateX(0) translateY(0);
  }

  .reveal-right {
    transform: translateX(24px) translateY(12px);
  }
  .reveal-right.is-visible {
    transform: translateX(0) translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".scroll-reveal").forEach((el) => observer.observe(el));
</script>