---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

const handhelds = [
  {
    name: "Nintendo Switch Lite",
    image: "/images/handhelds/switchlitemod.jpg",
    placeholder: "🎮",
    story: "i got this for really cheap and restored it and modded it to my liking.",
  },
  {
    name: "Nintendo Switch OLED",
    image: "/images/handhelds/switcholed.jpg",
    placeholder: "🕹️",
    story: "the one that started it all. Bricked it many times...",
  },
  {
    name: "Nintendo Switch Lite Mainboard",
    image: "/images/handhelds/switchlitemb.jpg",
    placeholder: "✨",
    story: "has a long story behind, but it works and is technically a working console.",
  },
];

const keyboards = [
  {
    name: "Mad 60HE",
    image: "/images/keyboards/mad60he.jpg",
    placeholder: "⌨️",
    story: "it is a cheap keyboard but it also my first serious keyboard that survived my vsrg journey.",
  },
  {
    name: "Wooting 60HE",
    image: "/images/keyboards/wooting60he.jpg",
    placeholder: "🔧",
    story: "coming soon...",
  },
];
---

<Base title="random stuff " description="things i'm into. collections, obsessions, and the little rabbit holes i fall into.">
  <Nav current="random" />

  <main class="pt-24 pb-8">
    <!-- Header -->
    <div class="px-6 mb-16">
      <div class="max-w-3xl mx-auto">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`} class="inline-flex items-center gap-1.5 text-xs font-mono text-text-muted/50 hover:text-brand transition-colors duration-300 mb-8">
          ← back
        </a>

        <h1 class="text-4xl sm:text-5xl font-heading font-bold text-text mb-4 scroll-reveal">
          random stuff
        </h1>
        <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-xl scroll-reveal" style="animation-delay: 0.1s">
          things i'm into. collections, obsessions, and the little rabbit holes i fall in.
        </p>
      </div>
    </div>

    <!-- Handhelds Section -->
    <section class="mb-24">
      <div class="px-6 mb-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-4 mb-2 scroll-reveal">
            <span class="text-3xl">🎮</span>
            <div>
              <p class="text-[11px] font-mono text-text-muted/50 tracking-widest uppercase">collection</p>
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-text">Handhelds</h2>
            </div>
          </div>
          <p class="text-sm text-text-muted max-w-lg scroll-reveal" style="animation-delay: 0.1s">little portable gaming devices i've collected. each one has its own vibe.</p>
        </div>
      </div>

      <div class="space-y-6 px-6">
        {handhelds.map((item, i) => (
          <div class:list={["max-w-4xl mx-auto scroll-reveal", i % 2 === 1 ? "reveal-right" : "reveal-left"]} style={`animation-delay: ${0.05 * i}s`}>
            <div class="group bg-bg-card border border-border rounded-2xl overflow-hidden card-hover">
              <div class:list={["flex flex-col", i % 2 === 1 ? "sm:flex-row-reverse" : "sm:flex-row"]}>
                <!-- Image -->
                <div class="sm:w-80 sm:min-w-80 h-56 sm:h-72 bg-bg-elevated flex items-center justify-center overflow-hidden relative">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="absolute inset-0 w-full h-full object-cover hidden"
                    loading="lazy"
                    onload="this.classList.remove('hidden'); this.parentElement.querySelector('.placeholder').classList.add('hidden')"
                  />
                  <div class="placeholder flex flex-col items-center justify-center gap-2">
                    <span class="text-5xl">{item.placeholder}</span>
                    <span class="text-[10px] font-mono text-text-muted/40">add photo</span>
                  </div>
                </div>

                <!-- Story -->
                <div class="flex-1 p-7 sm:p-9 flex flex-col justify-center">
                  <h3 class="text-xl sm:text-2xl font-heading font-semibold text-text group-hover:text-brand transition-colors duration-300 mb-3">
                    {item.name}
                  </h3>
                  <p class="text-sm sm:text-base text-text-muted leading-relaxed">
                    {item.story}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Keyboards Section -->
    <section class="mb-24">
      <div class="px-6 mb-10">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-4 mb-2 scroll-reveal">
            <span class="text-3xl">⌨️</span>
            <div>
              <p class="text-[11px] font-mono text-text-muted/50 tracking-widest uppercase">collection</p>
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-text">Keyboards</h2>
            </div>
          </div>
          <p class="text-sm text-text-muted max-w-lg scroll-reveal" style="animation-delay: 0.1s">mechanical keyboards and the rabbit hole of custom builds.</p>
        </div>
      </div>

      <div class="space-y-6 px-6">
        {keyboards.map((item, i) => (
          <div class:list={["max-w-4xl mx-auto scroll-reveal", i % 2 === 1 ? "reveal-right" : "reveal-left"]} style={`animation-delay: ${0.05 * i}s`}>
            <div class="group bg-bg-card border border-border rounded-2xl overflow-hidden card-hover">
              <div class:list={["flex flex-col", i % 2 === 1 ? "sm:flex-row-reverse" : "sm:flex-row"]}>
                <!-- Image -->
                <div class="sm:w-80 sm:min-w-80 h-56 sm:h-72 bg-bg-elevated flex items-center justify-center overflow-hidden relative">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="absolute inset-0 w-full h-full object-cover hidden"
                    loading="lazy"
                    onload="this.classList.remove('hidden'); this.parentElement.querySelector('.placeholder').classList.add('hidden')"
                  />
                  <div class="placeholder flex flex-col items-center justify-center gap-2">
                    <span class="text-5xl">{item.placeholder}</span>
                    <span class="text-[10px] font-mono text-text-muted/40">add photo</span>
                  </div>
                </div>

                <!-- Story -->
                <div class="flex-1 p-7 sm:p-9 flex flex-col justify-center">
                  <h3 class="text-xl sm:text-2xl font-heading font-semibold text-text group-hover:text-brand transition-colors duration-300 mb-3">
                    {item.name}
                  </h3>
                  <p class="text-sm sm:text-base text-text-muted leading-relaxed">
                    {item.story}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- More to come -->
    <div class="px-6 mb-16">
      <div class="max-w-2xl mx-auto bg-bg-card border border-dashed border-border rounded-2xl p-8 text-center scroll-reveal">
        <p class="text-3xl mb-3"></p>
        <p class="font-heading font-semibold text-lg text-text mb-2">
          more collections coming soon
        </p>
        <p class="text-sm text-text-muted">
          probably more stuff i get obsessed with
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  /* Scroll reveal, hidden by default, animated in by JS */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-left {
    transform: translateX(-24px) translateY(12px);
  }
  .reveal-left.is-visible {
    transform: translateX(0) translateY(0);
  }

  .reveal-right {
    transform: translateX(24px) translateY(12px);
  }
  .reveal-right.is-visible {
    transform: translateX(0) translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".scroll-reveal").forEach((el) => observer.observe(el));
</script>
